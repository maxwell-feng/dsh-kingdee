{
  "name": "dsh-kingdee",
  "version": "0.1.0",
  "description": "Kingdee Cloud Starry Sky (Kingdee ERP) secondary-development plugin for DeepSeek Harness (DSH). Provides typed tools over the Kingdee Cloud WebAPI, credential-safe configuration, a settings card, and a companion domain skill.",
  "type": "module",
  "main": "./lib/kd-core/index.js",
  "types": "./lib/kd-core/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/kd-core/index.d.ts",
      "default": "./lib/kd-core/index.js"
    },
    "./kd-core": {
      "types": "./lib/kd-core/index.d.ts",
      "default": "./lib/kd-core/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "README.zh.md",
    "INSTALL.md",
    "INSTALL.zh.md",
    "UPDATE.md",
    "UPDATE.zh.md",
    "UNINSTALL.md",
    "UNINSTALL.zh.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings-plugins": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "kingdee",
    "kingdee-cloud",
    "kingdee-starry-sky",
    "erp",
    "webapi",
    "bos"
  ]
}
