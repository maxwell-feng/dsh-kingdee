{
  "name": "dsh-kingdee",
  "version": "0.2.2",
  "description": "Kingdee Cloud Starry Sky secondary-development plugin for DeepSeek Harness (DSH) — 金蝶云星空二次开发插件（DSH）。Typed tools over the Kingdee Cloud WebAPI, credential-safe config, and a companion domain skill.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./kd-core": {
      "types": "./lib/kd-core/index.d.ts",
      "default": "./lib/kd-core/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "README.zh.md",
    "INSTALL.md",
    "INSTALL.zh.md",
    "UPDATE.md",
    "UPDATE.zh.md",
    "UNINSTALL.md",
    "UNINSTALL.zh.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxwell-feng/dsh-kingdee.git"
  },
  "homepage": "https://github.com/maxwell-feng/dsh-kingdee#readme",
  "bugs": {
    "url": "https://github.com/maxwell-feng/dsh-kingdee/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "kingdee",
    "kingdee-cloud",
    "kingdee-starry-sky",
    "erp",
    "webapi",
    "bos"
  ]
}
